5,"fontWeight":"600"}]},{"type":"frame","id":"GIUVM","name":"مراسلة المصمم","context":"c76rX؛ نفس بروشور ORD-0152 / Version 2.","width":"fill_container","height":48,"fill":"#2563EB","cornerRadius":10,"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"DOOCh","name":"التسمية","fill":"#FFFFFF","content":"مراسلة المصمم","fontFamily":"Cairo","fontSize":15,"fontWeight":"600"}]}]},{"type":"frame","id":"vesqy","name":"خريطة الوجهات — رابط أوردر واحد","width":"fill_container","fill":"#E8EFFA","cornerRadius":12,"layout":"vertical","gap":12,"padding":24,"children":[{"type":"text","id":"EfnvQ","name":"عنوان الخريطة","fill":"#1E3A8A","textGrowth":"fixed-width","width":"fill_container","content":"خريطة الوجهات — رابط أوردر واحد","textAlign":"right","fontFamily":"Cairo","fontSize":22,"fontWeight":"normal"},{"type":"text","id":"KUkmw","name":"المسارات والقيود","fill":"#334155","textGrowth":"fixed-width","width":"fill_container","content":"هذه خريطة تسليم خارج واجهة العميل؛ لا ادّعاء بتوصيل prototype قابل للنقر في صيغة الملف الحالية.\nرابط صالح → PAnfZ (ORD-0152 / شركة النور للدعاية). راجع البروشور → uwacC / Version 2 بنقرة واحدة.\nالمعاينة عند نجاح التحميل → kZV9f → d1k3q → QbCWM → ADDWE. لا يحدث اعتماد فور الضغط الأول.\nمراسلة المصمم → c76rX؛ الرجوع → uwacC. إرسال رسالة → UXk6V / مطلوب تعديل. بعد الاعتماد → pTeIG / قراءة فقط.\nإثبات الدفع: PAnfZ → RoYGa → PIhOH → PAnfZ مع N8adrk في التفاصيل. لا يتغير 1,000.00 مؤكد أو 1,728.00 متبقي.\nلاحقًا فقط بعد تأكيد الموظف: jE51a / المؤكد 1,500.00 والمتبقي 1,228.00. الرفض P86un → RoYGa لإرسال جديد.\nعمليات المطبعة فقط: ADDWE → Dzum7 → qdGNq → ENCqG عند الإكمال أو الإلغاء. لا أزرار عميل لتغيير الحالة.\nالفاتورة f7TPid عند الإصدار فقط؛ المعاينات الرسمية بلا تنزيل. أي رابط غير صالح → ENCqG دون بيانات خاصة.","textAlign":"right","fontFamily":"Cairo","fontSize":16,"fontWeight":"normal"},{"type":"text","id":"XUWW3","name":"سلوك الهاتف ولوحة المفاتيح — تسليم تنفيذ","fill":"#334155","textGrowth":"fixed-width","width":"fill_container","content":"التنفيذ: 16px هوامش، 44px حد لمس، safe-area أسفل شريط الاعتماد والإرسال. يُخصّص ارتفاع مستقل للمحتوى الممرّر؛ لا تراكب فوق الملف أو الحقول. مؤلف المحادثة يرتفع مع لوحة المفاتيح. عند فتح رفع الصورة أو ضيق مساحة النموذج تستخدم شاشة مركزة مع حفظ الإدخال. الصور وPDF لا تُعكس. التثبيت والإيماءات موصوفة هنا وليست وظائف محاكاة داخل الكانفاس.","textAlign":"right","fontFamily":"Cairo","fontSize":15,"fontWeight":"normal"}]}]},{"type":"frame","id":"r71tWz","name":"B — Alternative Business States","width":"fill_container","layout":"vertical","gap":28,"children":[{"type":"text","id":"DgXGg","name":"عنوان المجموعة","fill":"#0F172A","content":"لقطات الأعمال البديلة · رابط الأوردر","textAlign":"right","fontFamily":"Cairo","fontSize":26,"fontWeight":"700"},{"type":"frame","id":"yRLZw","name":"اعتماد وتصحيح ودفع — بدائل منفصلة","width":"fill_container","height":900,"layout":"none","children":[{"type":"frame","id":"mK9iC","x":3120,"y":20,"name":"معاينة التصميم المعتمد — حالة البندين 01 و02","context":"وجهة عرض التصميم للبندين المعتمدين داخل ORD-0152 فقط: كروت شخصية أو فلاير وفق البند المختار. التصميم الرسمي للعرض دون تنزيل، والمحادثة المعنية مغلقة. ليست شاشة S-087-01 لبروشور Version 2.","width":1400,"height":330,"fill":"#FFFFFF","cornerRadius":9,"stroke":"#E2E8F0","layout":"vertical","gap":12,"padding":20,"alignItems":"end","children":[{"type":"frame","id":"uQrFU","name":"عنوان البديل","width":"fill_container","justifyContent":"space_between","children":[{"type":"text","id":"r5I0U","name":"العودة","fill":"#2563EB","content":"العودة إلى الأوردر","textAlign":"right","fontFamily":"Cairo","fontSize":11,"fontWeight":"700"},{"type":"text","id":"P3y7FX","name":"العنوان","fill":"#0F172A","content":"عرض تصميم معتمد","textAlign":"right","fontFamily":"Cairo","fontSize":16,"fontWeight":"700"}]},{"type":"frame","id":"fwNmm","name":"سياق البند المختار","width":"fill_container","gap":9,"justifyContent":"end","children":[{"type":"frame","id":"v5B1J","name":"فلاير  •  معتمد","f