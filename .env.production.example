# ===== قالب بيئة الإنتاج — انسخه إلى .env.production واملأ القيم. لا ترفعه إلى git. =====
APP_NAME="اسم المطبعة"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://pbms.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=Africa/Cairo
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pbms
DB_USERNAME=pbms
DB_PASSWORD=                  # قوية وفريدة
DB_ROOT_PASSWORD=             # قوية وفريدة

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=pbms
REVERB_APP_KEY=               # عشوائي طويل
REVERB_APP_SECRET=            # عشوائي طويل
REVERB_HOST=127.0.0.1         # من داخل الحاوية (الخادم → Reverb)
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=pbms.example.com   # عنوان المتصفح العام
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

RUN_MIGRATIONS=true
